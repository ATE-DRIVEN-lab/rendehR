license: GPL-3.0-only
repository-code: "https://github.com/ATE-DRIVEN-lab/rendehR"
url: "https://ate-driven-lab.github.io/rendehR/"
keywords:
  - electronic health records
  - ICU
  - MIMIC
  - eICU
  - cohort
  - harmonization
  - R
